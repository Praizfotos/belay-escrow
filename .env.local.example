# Which of these a production deployment actually requires is declared in
# lib/config/requirements.ts. That list drives both the pre-deploy check
# (scripts/check-production-config.js, run by the Production Check workflow) and
# GET /api/health, which reports the running deployment's configuration status —
# 200 when every required value is set, 503 with the missing names when not.
# After deploying: curl --fail https://your-domain/api/health
#
# Tags below mirror lib/config/requirements.ts:
#   [required]   — a missing value fails the pre-deploy check and /api/health.
#   [recommended]— a missing value is warned about; the app runs degraded.
#   [optional]   — safe built-in default; listed for completeness.

# ─── Stellar / Horizon ────────────────────────────────────────────────────────
# [optional] Defaults to TESTNET. Set to PUBLIC for mainnet deployments.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER=https://stellar.expert/explorer/testnet

# ─── Soroban RPC (smart-contract interactions) ────────────────────────────────
# [optional] Defaults to the Soroban testnet endpoint.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── Soroban contracts ────────────────────────────────────────────────────────
# [required] Belay agreement contract: milestones, approvals, disputes and
# cancellation. Deployed by scripts/deploy-contract.sh (crate belay-contract).
NEXT_PUBLIC_CONTRACT_ID=

# [recommended] Escrow vault contract: holds the SEP-41 tokens and moves them
# on release or refund. Without it, milestone releases and refunds cannot be
# executed or read. Deployed by scripts/deploy-contract.sh (crate belay-vault).
NEXT_PUBLIC_VAULT_CONTRACT_ID=

# [recommended] SEP-41 token the vault custodies. On testnet this is the USDC
# Stellar Asset Contract (SAC) address. Funding and payouts are denominated in
# this token; without it, balances cannot be read and funding amounts have no
# token address.
NEXT_PUBLIC_ESCROW_TOKEN_ID=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# [required] No Supabase project to talk to; every query fails.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [required] Supabase rejects every request as unauthenticated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Wallet authentication (SERVER ONLY — never prefix with NEXT_PUBLIC_) ─────
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. If these
# leak, anyone can mint a token for any wallet and RLS stops meaning anything.

# [required] Supabase Dashboard → Settings → API → JWT Secret.
# Used to sign the access tokens whose `wallet_address` claim RLS authorizes on.
SUPABASE_JWT_SECRET=

# [required] Binds a challenge nonce to the wallet it was issued to.
# REQUIRED in production, and must differ from SUPABASE_JWT_SECRET — one key
# serving two cryptographic purposes means a leak in either path compromises
# both, and rotating the JWT secret would invalidate every open challenge.
# Outside production it falls back to SUPABASE_JWT_SECRET. Generate with:
#   openssl rand -base64 48
AUTH_CHALLENGE_SECRET=

# [required] Service role key (Supabase Dashboard → Settings → API →
# service_role). Backs the cross-instance replay guard and rate limiter (tables
# auth_nonces / auth_rate_limits, created by supabase-setup.sql). Without it
# both guards fall back to per-process memory, which does not hold on
# Vercel/Lambda: a captured challenge can be replayed against another instance
# and the rate limit becomes 30/min per instance. Also required for sign-out
# revocation (belay_revoke_token / belay_revoke_wallet).
SUPABASE_SERVICE_ROLE_KEY=

# [optional] How long a signed-in session lasts before the wallet must sign
# again. Defaults to 3600 (1 hour), capped at 43200 (12 hours). Sessions
# re-sign silently before expiry, so a short value costs no extra wallet
# prompts; it bounds how long a leaked token stays usable.
AUTH_SESSION_TTL_SECONDS=3600

# ─── App ──────────────────────────────────────────────────────────────────────
# [optional] Defaults to "Belay" / "1.0.0".
NEXT_PUBLIC_APP_NAME=Belay
NEXT_PUBLIC_APP_VERSION=1.0.0

# [required] Canonical public URL — used for OpenGraph/Twitter/PWA absolute
# URLs. In production set this to your real domain (e.g. https://belay.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
